```rust
use libc::{c_char, c_int, size_t, malloc};

pub unsafe fn strdup(str_ptr: *const c_char) -> *mut c_char {
    // Local helper function defined inside to compute strlen
    unsafe fn strlen_local(s: *const c_char) -> size_t {
        let mut len: size_t = 0;
        let mut p = s;
        while *p != 0 {
            len += 1;
            p = p.add(1);
        }
        len
    }

    // Local helper function defined inside to copy string including null terminator
    unsafe fn strcpy_local(dst: *mut c_char, src: *const c_char) -> *mut c_char {
        let mut d = dst;
        let mut s = src;
        loop {
            let c = *s;
            *d = c;
            if c == 0 {
                break;
            }
            d = d.add(1);
            s = s.add(1);
        }
        dst
    }

    let n: c_int = (strlen_local(str_ptr) + 1) as c_int;
    let dup = malloc(n as size_t) as *mut c_char;
    if !dup.is_null() {
        strcpy_local(dup, str_ptr);
    }
    dup
}
```
