// Direct translation of the given C function into Rust.
// libc is assumed available; we only use core language features here.
unsafe fn addColorBits(out: *mut u8, index: libc::size_t, bits: u32, mut input: u32) {
    // Helper functions defined inside as requested.
    // Convert size_t to u32 for bitwise operations safely assuming it fits.
    fn size_t_to_u32(x: libc::size_t) -> u32 {
        x as u32
    }

    // Compute m as in the C ternary expression: bits == 1 ? 7 : bits == 2 ? 3 : 1;
    fn compute_m(bits: u32) -> u32 {
        if bits == 1 {
            7
        } else if bits == 2 {
            3
        } else {
            1
        }
    }

    let m = compute_m(bits);

    // p = index & m (with index treated as unsigned int in C).
    let p: u32 = size_t_to_u32(index) & m;

    // in &= (1u << bits) - 1u;  (mask to 'bits' low bits)
    input &= (1u32 << bits) - 1u32;

    // in = in << (bits * (m - p));
    input <<= bits * (m - p);

    // Compute the byte index: index * bits / 8u
    let byte_index: usize = ((index as u64 * bits as u64) / 8u64) as usize;

    // out[index * bits / 8u] = / |= in; exact same logic
    let byte_ptr = out.add(byte_index);
    if p == 0 {
        *byte_ptr = input as u8;
    } else {
        *byte_ptr |= input as u8;
    }
}
