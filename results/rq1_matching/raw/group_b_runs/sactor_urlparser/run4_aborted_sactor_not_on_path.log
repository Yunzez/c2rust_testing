use libc::{c_char, c_int, malloc, strlen, strcpy};

pub unsafe fn strdup(str_ptr: *const c_char) -> *mut c_char {
    // int n = strlen(str) + 1;
    let n: c_int = strlen(str_ptr) as c_int + 1;

    // char *dup = malloc(n);
    let dup = malloc(n as usize) as *mut c_char;

    // if (dup) strcpy(dup, str);
    if !dup.is_null() {
        strcpy(dup, str_ptr);
    }

    // return dup;
    dup
}
```
