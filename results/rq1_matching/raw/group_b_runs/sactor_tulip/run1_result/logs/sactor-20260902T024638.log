pub unsafe fn ti_buffer_new(size: ::core::ffi::c_int) -> *mut ti_buffer {
    // Compute total size in bytes:
    // sizeof(ti_buffer) already includes space for vals[1], so we add (size - 1)
    // more TI_REAL (c_double) elements.
    let s: ::core::ffi::c_int = ::core::mem::size_of::<ti_buffer>() as ::core::ffi::c_int
        + (size - 1) * ::core::mem::size_of::<::core::ffi::c_double>() as ::core::ffi::c_int;

    // Allocate using libc::malloc
    let ret = libc::malloc(s as libc::size_t) as *mut ti_buffer;

    // Mirror the C behavior: assume allocation succeeds and write fields.
    // (If malloc returns null, this is undefined behavior in C as well.)
    (*ret).size = size;
    (*ret).pushes = 0;
    (*ret).index = 0;
    (*ret).sum = 0.0;

    ret
}
```
