```rust
pub unsafe fn readChunk_pHYs(
    info: *mut LodePNGInfo,
    data: *const ::core::ffi::c_uchar,
    chunkLength: usize,
) -> ::core::ffi::c_uint {
    if chunkLength != 9 {
        return 74; // invalid pHYs chunk size
    }

    // helper function defined inside, as required
    unsafe fn get_byte(ptr: *const ::core::ffi::c_uchar, offset: isize) -> ::core::ffi::c_uint {
        *ptr.offset(offset) as ::core::ffi::c_uint
    }

    (*info).phys_defined = 1;
    (*info).phys_x = 16_777_216u32 * get_byte(data, 0)
        + 65_536u32 * get_byte(data, 1)
        + 256u32 * get_byte(data, 2)
        + get_byte(data, 3);
    (*info).phys_y = 16_777_216u32 * get_byte(data, 4)
        + 65_536u32 * get_byte(data, 5)
        + 256u32 * get_byte(data, 6)
        + get_byte(data, 7);
    (*info).phys_unit = get_byte(data, 8);

    0 // OK
}
