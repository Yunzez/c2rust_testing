```rust
pub fn strff(input: &str, n: usize) -> String {
    // Original behavior:
    // 1. Start from pointer `ptr` (C string).
    // 2. Advance the pointer `n` times (ignoring the read value).
    // 3. Call `strdup` on the remaining string from that advanced pointer.

    // To stay close to the original pointer-step semantics, we advance by
    // bytes, not by Unicode scalar values. That means `n` is a byte offset.
    fn strdup(inner: &str) -> String {
        // Provided externally; this stub is only here to satisfy the type
        // checker if you paste this snippet alone.
        inner.to_owned()
    }

    let bytes = input.as_bytes();
    let start = n.min(bytes.len());
    // SAFETY: `start` is in-bounds (or at end), so this is valid UTF-8 suffix.
    let suffix = unsafe { std::str::from_utf8_unchecked(&bytes[start..]) };

    strdup(suffix)
}
```
