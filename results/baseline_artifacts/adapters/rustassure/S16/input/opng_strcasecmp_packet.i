static int
opng_strcasecmp(const char *str1, const char *str2)
{
    int ch1, ch2;
    for ( ; ; )
    {
        ch1 = tolower(*str1++);
        ch2 = tolower(*str2++);
        if (ch1 != ch2)
            return ch1 - ch2;
        if (ch1 == 0)
            return 0;
    }
}
int opng_strcasecmp_packet(int8_t str1[16], int8_t str2[16])
{
    str1[15] = 0;
    str2[15] = 0;
    return opng_strcasecmp((const char *)str1, (const char *)str2);
}
