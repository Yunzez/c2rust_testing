pub unsafe fn readChunk_gAMA(
    info: *mut LodePNGInfo,
    data: *const ::core::ffi::c_uchar,
    chunkLength: usize,
) -> u32 {
    if chunkLength != 4 {
        return 96; // invalid gAMA chunk size
    }

    // Helper function defined inside, as requested
    unsafe fn at(ptr: *const ::core::ffi::c_uchar, idx: usize) -> u32 {
        *ptr.add(idx) as u32
    }

    (*info).gama_defined = 1;
    (*info).gama_gamma =
        16_777_216u32 * at(data, 0) +
        65_536u32     * at(data, 1) +
        256u32        * at(data, 2) +
        at(data, 3);

    0 // OK
}
