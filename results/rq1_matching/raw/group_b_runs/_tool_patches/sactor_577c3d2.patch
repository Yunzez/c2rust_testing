@@ -17,12 +17,15 @@ def extract_spec_block(text: str) -> Optional[str]:
     """Extract the JSON spec block between ----SPEC---- and ----END SPEC----.
     Returns the raw JSON text or None if not found.
     """
+    # Tolerate model-format variation: optional trailing dashes after "END SPEC"
+    # (e.g. gpt-5.x emits "----END SPEC" without a trailing dash run) and stray
+    # surrounding whitespace around the markers/code fences.
     pattern = re.compile(
