+    def _close_type_closure(self, code: str) -> str:
+        """Append missing type definitions (aliases / structs / unions / enums) that `code`
+        references but does not define, resolving them from the c2rust translation.
+        Fixes the dangling-typedef scaffold bug (FILE = _IO_FILE, fn-ptr typedefs)."""
+        import re
+        c2r = self.c2rust_translation
+        # FILE: map to libc::FILE instead of dragging glibc's _IO_FILE struct chain
+        # (BitfieldStruct derive + _IO_marker extern types) into the scaffold.
+        code = re.sub(r'(?m)^\s*pub type FILE = _IO_FILE;\s*$',
+                      'pub type FILE = libc::FILE;', code)
+        RUST_BUILTINS = {
+            'u8', 'u16', 'u32', 'u64', 'usize', 'i8', 'i16', 'i32', 'i64', 'isize',
+            'f32', 'f64', 'bool', 'char', 'str', 'Option', 'Some', 'None', 'Copy',
+            'Clone', 'Debug', 'unsafe', 'extern', 'fn', 'pub', 'type', 'struct',
+            'union', 'enum', 'mut', 'const', 'core', 'std', 'ffi', 'libc',
+            'c_int', 'c_uint', 'c_long', 'c_ulong', 'c_char', 'c_uchar', 'c_schar',
+            'c_short', 'c_ushort', 'c_double', 'c_float', 'c_void', 'c_longlong',
+            'c_ulonglong', 'FILE',
+        }
+
+        def find_def(name):
+            # type alias in the c2rust output
+            m = re.search(rf'(?m)^pub type {re.escape(name)}\b[^;]*;', c2r)
+            if m:
+                return m.group(0)
+            # struct/union/enum definition (with attribute lines above it)
+            m = re.search(
+                rf'(?m)^((?:#\[[^\n]*\]\n)*)pub (?:struct|union|enum) {re.escape(name)}\b.*?^\}}',
+                c2r, re.S)
+            if m:
+                return m.group(0)
+            return None
+
+        for _ in range(10):  # transitive closure, bounded
+            defined = set(re.findall(
+                r'(?m)^\s*pub (?:type|struct|union|enum) (\w+)', code))
+            used = set()
+            # right-hand sides of type aliases
+            for m in re.finditer(r'(?m)^\s*pub type \w+ = ([^;]+);', code):
+                used |= set(re.findall(r'\b([A-Za-z_]\w*)\b', m.group(1)))
+            # struct/union field types
+            for m in re.finditer(r'(?m)^\s*pub \w+\s*:\s*(.+?),?\s*$', code):
+                used |= set(re.findall(r'\b([A-Za-z_]\w*)\b', m.group(1)))
+            missing = sorted(
+                u for u in used - defined - RUST_BUILTINS if find_def(u))
+            if not missing:
+                break
+            for name in missing:
+                definition = find_def(name)
+                logger.info(
+                    "Type-closure fix: appending missing definition of %s to struct code", name)
+                code = definition + '\n' + code
+        return code
+
     def _prepare_function_context(
