pub unsafe fn makeMaps_d(s: *mut DState) {
    // Mirror the C signature and behavior as closely as possible.
    // C: void makeMaps_d ( DState* s )
    if s.is_null() {
        return;
    }

    let s_ref: &mut DState = &mut *s;

    // C: Int32 i;
    // C: s->nInUse = 0;
    s_ref.nInUse = 0;

    // C: for (i = 0; i < 256; i++)
    //       if (s->inUse[i]) {
    //          s->seqToUnseq[s->nInUse] = i;
    //          s->nInUse++;
    //       }
    let mut i: i32 = 0;
    while i < 256 {
        if s_ref.inUse[i as usize] != 0 {
            s_ref.seqToUnseq[s_ref.nInUse as usize] = i as u8;
            s_ref.nInUse += 1;
        }
        i += 1;
    }
}
