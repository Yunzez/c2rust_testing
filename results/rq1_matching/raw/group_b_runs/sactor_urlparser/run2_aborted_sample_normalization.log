```rust
pub unsafe fn strdup(str_ptr: *const libc::c_char) -> *mut libc::c_char {
    // Preserve C semantics as closely as possible:
    // n is an `int`, and malloc is called with an `int`-sized value.
    let n: libc::c_int = libc::strlen(str_ptr)
        .wrapping_add(1)           // strlen + 1
        as libc::c_int;            // cast to int like in C

    // In C: malloc(n) where n is int; here we cast to size_t explicitly.
    let dup = libc::malloc(n as libc::size_t) as *mut libc::c_char;

    if !dup.is_null() {
        libc::strcpy(dup, str_ptr);
    }

    dup
}
