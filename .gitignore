**/fuzz/artifacts/
**/fuzz/coverage/

# CMake build output — keep only compile_commands.json (needed by c2rust + stu_selector)
projects/*/build/*
!projects/*/build/compile_commands.json

# Object / binary artifacts
*.o
*.a
*.bin
a.out

# Python
__pycache__/
*.pyc

# Editor
*.swp

# obsolete regenerated reports (deleted in 53b22d3; harvest_census/stage_b mains re-clobber them)
results/boundary_census_v1.md
results/stage_b_v1.md

*.env

# LLM-translation differential pairs (derived from out/; regenerate via the shim recipe)
experiments/llm_transpiler/diff/

