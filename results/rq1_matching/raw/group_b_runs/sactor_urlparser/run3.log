    let fmt_url: *mut libc::c_char = strdup(url as *const libc::c_char);
    let ret: *mut libc::c_char = libc::malloc(1) as *mut libc::c_char;

    if tmp.is_null() || tmp_url.is_null() || fmt_url.is_null() || ret.is_null() {
