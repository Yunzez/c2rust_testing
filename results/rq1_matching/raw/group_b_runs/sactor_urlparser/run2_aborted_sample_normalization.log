    // Helper function defined inside, as requested
    unsafe fn strlen_c(s: *const libc::c_char) -> libc::size_t {
        let mut p = s;
        while *p != 0 {
            p = p.add(1);
        }
        p.offset_from(s) as libc::size_t
    }

    if str_ptr.is_null() {
        return std::ptr::null_mut();
    }

    let len = strlen_c(str_ptr); // length without the null terminator
    let n = len + 1;             // include space for terminating '\0'

    let dup = libc::malloc(n) as *mut libc::c_char;
    if dup.is_null() {
