    let shift: u32 = 16u32 - mode_out_ref.bitdepth;

    // input conversion
    if mode_in_ref.colortype as u8 == LodePNGColorType::LCT_GREY as u8
        || mode_in_ref.colortype as u8 == LodePNGColorType::LCT_GREY_ALPHA as u8
