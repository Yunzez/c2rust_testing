```rust
pub fn strrwd(ptr: &str, n: usize) -> String {
    // Original semantics:
    //   - `ptr` pointed somewhere *inside* a C string
    //   - walk `n` bytes backwards
    //   - call `strdup` on the resulting pointer (i.e., duplicate the suffix)
    //
    // Idiomatic, safe approximation:
    //   - treat the input as an owned/borrowed UTF‑8 string
    //   - take the suffix starting `n` bytes from the *end*.
    //
    // This matches the idea of "rewind n bytes from (end-ish) position and
    // duplicate the remainder" without raw pointers.

    fn byte_suffix_from_end(s: &str, n: usize) -> &str {
        // Work in bytes, as the original code did (it stepped by raw bytes).
        let len = s.len();
        if n >= len {
            return "";
        }
        // Safe: splitting at a byte boundary that may be in the middle of a
        // code point would be invalid, so we walk to a valid UTF‑8 boundary.
        //
        // Start from the target byte index (from the beginning).
        let mut idx = len - n;

        // Move idx forward until it's at a char boundary.
        while !s.is_char_boundary(idx) && idx < len {
            idx += 1;
        }

        &s[idx..]
    }

    let slice = byte_suffix_from_end(ptr, n);
    // Use the provided safe `strdup` helper to allocate a new String.
    strdup(slice)
}
```
