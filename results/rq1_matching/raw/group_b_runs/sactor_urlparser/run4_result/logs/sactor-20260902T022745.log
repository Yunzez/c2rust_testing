use std::ffi::{CStr, CString};
use libc;

fn show(label: *const libc::c_char, v: *mut libc::c_char) {
    // Convert the label from C string to &str
    let label = unsafe {
        CStr::from_ptr(label)
            .to_str()
            .unwrap_or("") // Fallback to empty string on invalid UTF-8
    };

    // Convert v from *mut c_char to Option<String>, taking ownership if non-null
    let v: Option<String> = if v.is_null() {
        None
    } else {
        let s = unsafe { CStr::from_ptr(v) };
        Some(s.to_string_lossy().into_owned())
    };

    // Call the idiomatic function
    show_idiomatic(label, v);

    // No conversion back is needed: the idiomatic version takes ownership
    // of the String (if any) and is responsible for dropping it.
}
```
