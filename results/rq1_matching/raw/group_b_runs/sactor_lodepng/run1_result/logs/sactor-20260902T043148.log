        *g_out = g >> shift;
        *b_out = b >> shift;
    } else if mode_out_ref.colortype as u8 == LodePNGColorType::LCT_PALETTE as u8 {
        // a 16-bit color cannot be in the palette
        if (r >> 8) != (r & 255) || (g >> 8) != (g & 255) || (b >> 8) != (b & 255) {
            return 82;
        }
        let mut i: u32 = 0;
        while (i as usize) < mode_out_ref.palettesize as usize {
