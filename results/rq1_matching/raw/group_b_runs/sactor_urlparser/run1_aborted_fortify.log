use libc::{c_char, c_ulong, malloc};

pub unsafe fn strdup(str_ptr: *const c_char) -> *mut c_char {
    // Local helper: strlen
    unsafe fn strlen_local(s: *const c_char) -> c_ulong {
        let mut len: c_ulong = 0;
        // Walk the pointer until we hit the null terminator.
        // We rely on the caller passing a valid C string, as in the original C code.
        let mut p = s;
        while *p != 0 {
            len = len.wrapping_add(1);
            p = p.add(1);
        }
        len
    }

    // Local helper: strcpy
    unsafe fn strcpy_local(dst: *mut c_char, src: *const c_char) -> *mut c_char {
        let mut d = dst;
        let mut s = src;
        loop {
            let c = *s;
            *d = c;
            if c == 0 {
                break;
            }
            d = d.add(1);
            s = s.add(1);
        }
        dst
    }

    // Use size_t-like type (c_ulong here) consistently to avoid truncation.
    let len: c_ulong = strlen_local(str_ptr);
    // Add 1 for the terminating null byte.
    let n: c_ulong = len.wrapping_add(1);

    // Allocate exactly n bytes, as in the C version.
    let dup = malloc(n as usize) as *mut c_char;
    if !dup.is_null() {
        strcpy_local(dup, str_ptr);
    }
    dup
}
