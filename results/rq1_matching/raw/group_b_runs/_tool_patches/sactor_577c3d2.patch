+        r"-+\s*SPEC\s*-+\s*\n```(?:json)?\n(.*?)\n```\s*\n-+\s*END SPEC\s*-*", re.S)
     m = pattern.search(text)
     if not m:
         # fallback: tolerate missing code fences
-        alt = re.compile(r"-+SPEC-+\n(.*?)\n-+END SPEC-+", re.S)
+        alt = re.compile(r"-+\s*SPEC\s*-+\s*\n(.*?)\n-+\s*END SPEC\s*-*", re.S)
         m = alt.search(text)
         if not m:
             return None
